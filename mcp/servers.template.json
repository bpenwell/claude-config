{
  "zola": {
    "type": "stdio",
    "command": "node",
    "args": ["${ZOLA_MCP_PATH}"],
    "env": {
      "ZOLA_REFRESH_TOKEN": "${ZOLA_REFRESH_TOKEN}"
    }
  },
  "gsc": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "mcp-server-gsc"],
    "env": {
      "GOOGLE_APPLICATION_CREDENTIALS": "${GSC_SERVICE_ACCOUNT_JSON}"
    }
  },
  "posthog": {
    "type": "http",
    "url": "https://mcp.posthog.com/mcp",
    "headers": {
      "Authorization": "Bearer ${POSTHOG_API_KEY}",
      "x-posthog-project-id": "${POSTHOG_PROJECT_ID}"
    }
  }
}
