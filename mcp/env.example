# Copy to ~/.claude-config.env and fill in real values, then run the installer.
#   Linux/macOS/WSL : cp mcp/env.example ~/.claude-config.env
#   Windows         : copy mcp\env.example $HOME\.claude-config.env
# NEVER commit the filled-in file.
#
# Leave a server's credentials blank to skip installing that server entirely.
# Paths may use ~, $HOME, or %USERPROFILE% -- all three are expanded.
# Use forward slashes on Windows too (C:/Users/you/...), they work everywhere.

# Zola MCP: absolute path to the installed server entrypoint.
#   Find it with: node -e "console.log(require('path').join(process.env.npm_config_prefix||'','lib/node_modules/zola-mcp/dist/index.js'))"
#   or simply:    npm root -g      then append /zola-mcp/dist/index.js
# (npx is broken for this package -- its shebang is malformed, so invoke node directly.)
ZOLA_MCP_PATH=
ZOLA_REFRESH_TOKEN=

# Google Search Console: path to a downloaded service-account JSON key.
GSC_SERVICE_ACCOUNT_JSON=$HOME/.config/mcp-credentials/gsc-service-account.json

# PostHog personal API key (starts with phx_) and numeric project id.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
